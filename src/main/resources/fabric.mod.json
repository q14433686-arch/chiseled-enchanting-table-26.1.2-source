{
  "schemaVersion": 1,
  "id": "enchantment_fusion",
  "version": "${version}",
  "name": "Enchantment Fusion",
  "description": "Order-sensitive Vanilla+ enchantment fusion ([A ▷ B] != [B ▷ A]) and cross-domain transmutations for Minecraft 26.1.2 on Fabric.",
  "authors": [
    "q14433686-arch"
  ],
  "contact": {
    "sources": "https://github.com/q14433686-arch/chiseled-enchanting-table-26.1.2-source"
  },
  "license": "MIT",
  "icon": "assets/enchantment_fusion/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "enchantment_fusion.EnchantmentFusion"
    ],
    "client": [
      "enchantment_fusion.EnchantmentFusionClient"
    ],
    "jei_mod_plugin": [
      "enchantment_fusion.compat.jei.EnchantmentFusionJeiPlugin"
    ],
    "rei_client": [
      "enchantment_fusion.compat.rei.EnchantmentFusionReiPlugin"
    ]
  },
  "mixins": [
    "enchantment_fusion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.151.0"
  },
  "suggests": {
    "chiseled-enchanting-table": "*"
  }
}
